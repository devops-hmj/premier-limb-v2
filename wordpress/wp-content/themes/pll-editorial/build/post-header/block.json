{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "pll/post-header",
  "version": "1.0.0",
  "title": "PLL Post Header",
  "category": "theme",
  "icon": "heading",
  "description": "Article header: breadcrumb, headline, and the reading/category/author/date meta row. Template-only block.",
  "textdomain": "pll-editorial",
  "supports": {
    "html": false,
    "customClassName": false,
    "inserter": false
  },
  "usesContext": [
    "postId"
  ],
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}